#!/usr/bin/env bash
# Followspot launcher.
#
#   ./followspot [script.md] [-m model.bin] [-p port] [--no-open] [--no-vad] [-- whisper-server flags]
#   ./followspot download <name>     # small.en, medium.en, large-v3-turbo, ... or vad
#
# Starts whisper.cpp's server on localhost, which also serves the prompter
# page, then opens it in your browser.
set -euo pipefail

cd "$(dirname "$0")"
PORT="${FOLLOWSPOT_PORT:-8178}"
MODEL="${FOLLOWSPOT_MODEL:-}"
OPEN=1
VAD=1
SCRIPT=""
EXTRA=()
VAD_MODEL_NAME="silero-v6.2.0"

usage() {
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

if [[ "${1:-}" == "download" ]]; then
  name="${2:?usage: ./followspot download <name>, e.g. small.en or vad}"
  mkdir -p models
  if [[ "$name" == "vad" ]]; then
    name="$VAD_MODEL_NAME"
    url="https://huggingface.co/ggml-org/whisper-vad/resolve/main/ggml-${name}.bin"
  else
    url="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-${name}.bin"
  fi
  echo "Downloading ${url}"
  curl -fL --progress-bar -o "models/ggml-${name}.bin.part" "$url"
  mv "models/ggml-${name}.bin.part" "models/ggml-${name}.bin"
  echo "Saved models/ggml-${name}.bin"
  exit 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -m|--model) MODEL="$2"; shift 2 ;;
    -p|--port) PORT="$2"; shift 2 ;;
    --no-open) OPEN=0; shift ;;
    --no-vad) VAD=0; shift ;;
    -h|--help) usage ;;
    --) shift; EXTRA=("$@"); break ;;
    -*) echo "Unknown option: $1" >&2; usage 1 ;;
    *) SCRIPT="$1"; shift ;;
  esac
done

if ! command -v whisper-server >/dev/null; then
  echo "whisper-server not found." >&2
  echo "  macOS: brew install whisper-cpp" >&2
  echo "  Linux: build it from https://github.com/ggml-org/whisper.cpp and put whisper-server on PATH" >&2
  exit 1
fi

open_url() {
  if command -v open >/dev/null; then open "$1"
  elif command -v xdg-open >/dev/null; then xdg-open "$1" >/dev/null 2>&1
  else echo "Open $1 in your browser."
  fi
}

threads() {
  sysctl -n hw.perflevel0.physicalcpu 2>/dev/null \
    || sysctl -n hw.physicalcpu 2>/dev/null \
    || nproc 2>/dev/null \
    || echo 4
}

# Model: -m / FOLLOWSPOT_MODEL, else the largest one found. Screen Studio's
# copy of medium ranks above small/base so a quick base.en download for
# testing doesn't silently downgrade accuracy.
if [[ -z "$MODEL" ]]; then
  for candidate in \
    models/ggml-large-v3-turbo.bin models/ggml-medium.en.bin models/ggml-medium.bin \
    "$HOME/Library/Application Support/Screen Studio/models/ggml-medium.bin" \
    models/ggml-small.en.bin models/ggml-base.en.bin; do
    if [[ -f "$candidate" ]]; then MODEL="$candidate"; break; fi
  done
fi
if [[ -z "$MODEL" || ! -f "$MODEL" ]]; then
  echo "No Whisper model found. Get one with: ./followspot download small.en" >&2
  exit 1
fi

# Voice activity detection: on whenever a Silero VAD model is in models/.
# whisper.cpp then skips non-speech audio instead of transcribing it, which
# stops Whisper inventing words ("you", "thanks for watching") during pauses
# and room noise. Skipped if --no-vad, or if you pass your own --vad flags.
VAD_ARGS=()
VAD_FILE=""
if [[ "$VAD" == 1 && " ${EXTRA[*]-} " != *" --vad "* ]]; then
  for candidate in models/ggml-silero-*.bin; do
    [[ -f "$candidate" ]] && VAD_FILE="$candidate"   # glob sorts, so the newest version wins
  done
  [[ -n "$VAD_FILE" ]] && VAD_ARGS=(--vad -vm "$VAD_FILE")
fi

# Link (not copy) the script so edits show up in the prompter live.
if [[ -n "$SCRIPT" ]]; then
  if [[ ! -f "$SCRIPT" ]]; then echo "Script not found: $SCRIPT" >&2; exit 1; fi
  ln -sf "$(cd "$(dirname "$SCRIPT")" && pwd)/$(basename "$SCRIPT")" public/current.md
fi

URL="http://127.0.0.1:${PORT}/"
THREADS="${FOLLOWSPOT_THREADS:-$(threads)}"
echo "Model:  $MODEL"
echo "Threads: $THREADS"
if [[ -n "$VAD_FILE" ]]; then echo "VAD:    $VAD_FILE"
elif [[ "$VAD" == 1 ]]; then echo "VAD:    off (./followspot download vad to enable)"
fi
[[ -L public/current.md ]] && echo "Script: $(readlink public/current.md)"
echo "Open:   $URL   (Ctrl+C to stop)"

if [[ "$OPEN" == 1 ]]; then
  (
    for _ in $(seq 1 60); do
      if curl -fs -o /dev/null "$URL"; then open_url "$URL"; exit 0; fi
      sleep 0.5
    done
  ) &
fi

exec whisper-server \
  -m "$MODEL" \
  --host 127.0.0.1 \
  --port "$PORT" \
  --public public \
  -l en \
  -nt \
  -t "$THREADS" \
  ${VAD_ARGS[@]+"${VAD_ARGS[@]}"} \
  ${EXTRA[@]+"${EXTRA[@]}"}
